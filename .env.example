# Gateway binds to loopback by default. Remote binds require WX_API_KEY (>= 32 chars).
WX_BIND_ADDR=127.0.0.1:8080
WX_API_KEY=

# Operator-controlled OpenAI-compatible provider adapter.
# Local Ollama is the secure default. No external provider is called unless changed.
WX_UPSTREAM_NAME=ollama
WX_UPSTREAM_BASE_URL=http://127.0.0.1:11434/v1
WX_UPSTREAM_API_KEY=
WX_UPSTREAM_MODEL=llama3.2
WX_UPSTREAM_LOCATION=local
WX_UPSTREAM_TIMEOUT_SECONDS=60

# Local browser origin used by Dioxus: dx serve --port 8081
WX_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Receipts contain metadata and acceptance-check results, not prompts or outputs.
WX_RECEIPT_DIR=./data/receipts
