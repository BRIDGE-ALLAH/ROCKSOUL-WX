# Copy to .env.production and replace every example value.
WX_IMAGE_TAG=v0.2.0
WX_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
WX_CORS_ORIGINS=https://app.example.com
WX_ROUTE_OBJECTIVE=balanced
WX_RATE_LIMIT_PER_MINUTE=120

# Optional secret-file locations. Keep the actual files outside version control.
WX_GATEWAY_KEY_FILE=./secrets/gateway_api_key
WX_PRIMARY_PROVIDER_KEY_FILE=./secrets/primary_provider_api_key
WX_RECEIPT_HMAC_KEY_FILE=./secrets/receipt_hmac_key
